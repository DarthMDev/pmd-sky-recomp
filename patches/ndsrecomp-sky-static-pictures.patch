+    for (int bg = 0; bg < 4; ++bg) {
+        if (!(u.dispcnt & (0x100u << bg))) continue;
+        const uint16_t cnt = u.bgcnt[bg];
+        if (cnt & 0x40u) can_widen = false; // mosaic is native-only
+        const BgKind kind = bg_kind(u, bg);
+        if (kind != BgKind::Affine && kind != BgKind::Extended) continue;
