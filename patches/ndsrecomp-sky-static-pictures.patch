+        job.palette[0] && job.oam[0] && job.vram[0] && !job.bg0_3d &&
+        !u.capture_latch && ((u.dispcnt >> 16) & 3u) == 1u && !(u.dispcnt & 0x80u);
+    const uint32_t bg_mode = u.dispcnt & 7u;
