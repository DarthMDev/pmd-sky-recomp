+            const uint32_t base = (cnt & 0x1F00u) << 6u;
+            const uint32_t height = (cnt & 0x4000u) ? 512u : 256u;
+            const uint32_t bytes_per_pixel = (cnt & 0x0004u) ? 2u : 1u;
+            const uint32_t end = base + 512u * height * bytes_per_pixel;
+            constexpr uint32_t kChunkSize = 0x4000u;
+            if (end > 32u * kChunkSize) {
