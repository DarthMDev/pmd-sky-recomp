+// Two scanlines with different references, followed by a VBlank register and
+// VRAM change. A post-frame redraw would pick up the wrong source pixels.
+bool test_adaptive_affine_bitmap(bool threaded, bool direct) {
+    constexpr uint16_t kWidth = 342;
+    constexpr int kMargin = (kWidth - 256) / 2;
+    constexpr uint32_t kBlack = 0xFF000000u;
+    const uint32_t red = to_rgb32(rgb6(0x001Fu));
+    const uint32_t green = to_rgb32(rgb6(0x03E0u));
+    const uint32_t blue = to_rgb32(rgb6(0x7C00u));
+    static std::array<std::array<uint8_t, 0x4000>, 16> bitmap;
+
+    nds_gpu2d_set_threaded(threaded, 2);
+    nds_gpu2d_reset();
+    g_3d_output_width = kWidth;
+    g_3d_render_xpos = 0;
+    g_view = {};
+    g_palette.fill(0);
+    constexpr std::array<uint16_t, 4> kColors{0, 0x801Fu, 0x83E0u, 0xFC00u};
+    for (size_t i = 1; i < kColors.size(); ++i)
+        write16(g_palette, i * 2, kColors[i] & 0x7FFFu);
+    for (size_t i = 0; i < bitmap.size(); ++i) {
+        bitmap[i].fill(0);
+        g_view.bg[i] = bitmap[i].data();
+    }
+    auto put_pixel = [&](int x, int y, uint8_t index) {
+        const unsigned addr = static_cast<unsigned>((y * 512 + x) * (direct ? 2 : 1));
+        auto& chunk = bitmap[addr >> 14];
+        const uint16_t value = direct ? kColors[index] : index;
+        chunk[addr & 0x3FFFu] = static_cast<uint8_t>(value);
+        if (direct) chunk[(addr & 0x3FFFu) + 1] = static_cast<uint8_t>(value >> 8);
+    };
+    for (int y = 0; y < 192; ++y) {
+        put_pixel(0, y, 1);
+        put_pixel(21, y, 2);
+        put_pixel(362, y, 3);
+    }
+    Unit& u = g_unit[0];
+    u.dispcnt = 0x00010405u;  // composite, mode 5, BG2 enabled
+    const uint16_t bitmap_control = 0x8080u | (direct ? 0x4u : 0u);
+    u.bgcnt[2] = bitmap_control;   // non-wrapping 512x256 bitmap
+    u.pa[0] = 256;
+    u.pd[0] = 256;
+    u.refx[0] = 64 * 256;
+    nds_gpu2d_start_frame();
+    for (int y = 0; y < 192; ++y) {
+        if (y == 1) u.refx_internal[0] = 32 * 256;
+        if (y == 2) u.refx_internal[0] = 64 * 256;
+        nds_gpu2d_render_scanline(y);
+    }
+    nds_gpu2d_finish_frame();
+
+    // A new scene can update the live registers and VRAM before presentation.
+    u.dispcnt = 0x10000u;
+    put_pixel(21, 0, 0);
+    uint16_t width = 0;
+    const uint32_t* native = nds_gpu2d_framebuffer(0);
+    const uint32_t* wide = nds_gpu2d_adaptive_framebuffer(
+        0, &width, NdsGpu2dScene::ScrollingGroundMap);
+    if (width != kWidth || wide[0] != green || wide[kWidth - 1] != blue ||
+        wide[kWidth] != kBlack || wide[kWidth + 11] != red ||
+        wide[191 * kWidth] != green)
+        return false;
+    for (int y = 0; y < 192; ++y)
+        if (!std::equal(native + y * 256, native + (y + 1) * 256,
+                        wide + y * width + kMargin))
+            return false;
+
+    for (const auto scene : {NdsGpu2dScene::Unknown, NdsGpu2dScene::StaticPicture}) {
+        wide = nds_gpu2d_adaptive_framebuffer(0, &width, scene);
+        if (width != kWidth || wide[0] != kBlack || wide[kWidth - 1] != kBlack)
+            return false;
+    }
+
+    // A bitmap whose source banks mirror one another stays centered.
+    g_view.bg[1] = g_view.bg[0];
+    u.dispcnt = 0x00010405u;
+    nds_gpu2d_start_frame();
+    for (int y = 0; y < 192; ++y) nds_gpu2d_render_scanline(y);
+    nds_gpu2d_finish_frame();
+    wide = nds_gpu2d_adaptive_framebuffer(0, &width, NdsGpu2dScene::ScrollingGroundMap);
+    if (width != kWidth || wide[0] != kBlack || wide[kWidth - 1] != kBlack)
+        return false;
+    g_view.bg[1] = bitmap[1].data();
+
+    // A single wrapping scanline disqualifies the full frame, even though its
+    // last scanline and the live registers could otherwise permit widening.
+    u.dispcnt = 0x00010405u;
+    nds_gpu2d_start_frame();
+    for (int y = 0; y < 192; ++y) {
+        u.bgcnt[2] = bitmap_control | (y == 100 ? 0x2000u : 0u);
+        nds_gpu2d_render_scanline(y);
+    }
+    nds_gpu2d_finish_frame();
+    wide = nds_gpu2d_adaptive_framebuffer(0, &width, NdsGpu2dScene::ScrollingGroundMap);
+    nds_gpu2d_set_threaded(false, 1);
+    return width == kWidth && wide[0] == kBlack && wide[kWidth - 1] == kBlack;
+}
+
+bool test_adaptive_affine_tiles() {
+    constexpr uint16_t kWidth = 342;
+    const uint32_t red = to_rgb32(rgb6(0x001Fu));
+    const uint32_t green = to_rgb32(rgb6(0x03E0u));
+    std::array<uint8_t, 0x4000> map{};
+    std::array<uint8_t, 0x4000> tiles{};
+    std::fill_n(tiles.data() + 64, 64, 1u);
+    std::fill_n(tiles.data() + 128, 64, 2u);
+    g_view = {};
+    g_view.bg[0] = map.data();
+    g_view.bg[1] = tiles.data();
+    g_palette.fill(0);
+    write16(g_palette, 2, 0x001Fu);
+    write16(g_palette, 4, 0x03E0u);
+    g_3d_output_width = kWidth;
+
+    // Standard affine maps use one byte per tile. Extended affine maps use
+    // two bytes per tile, with palette and flip bits in the upper byte.
+    for (bool extended : {false, true}) {
+        nds_gpu2d_reset();
+        map.fill(0);
+        const int bytes_per_entry = extended ? 2 : 1;
+        for (int row = 0; row < 24; ++row) {
+            map[(row * 64 + 2) * bytes_per_entry] = 1;
+            map[(row * 64 + 45) * bytes_per_entry] = 2;
+        }
+        Unit& u = g_unit[0];
+        u.dispcnt = 0x00010400u | (extended ? 5u : 2u);
+        u.bgcnt[2] = 0x8004u;  // 512x512, character base 0x4000
+        u.pa[0] = 256;
+        u.pd[0] = 256;
+        u.refx[0] = 64 * 256;
+        nds_gpu2d_start_frame();
+        for (int y = 0; y < 192; ++y) nds_gpu2d_render_scanline(y);
+        nds_gpu2d_finish_frame();
+        uint16_t width = 0;
+        const uint32_t* wide = nds_gpu2d_adaptive_framebuffer(
+            0, &width, NdsGpu2dScene::ScrollingGroundMap);
+        if (width != kWidth || wide[0] != red || wide[kWidth - 1] != green ||
+            wide[191 * kWidth] != red)
+            return false;
+    }
+    g_view = {};
+    return true;
+}
