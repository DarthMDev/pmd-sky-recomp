+bool test_bottom_dungeon_margins() {
+    std::array<uint8_t, 0x4000> obj_vram{};
+    std::array<uint8_t, 0x4000> bg_vram{};
+    std::array<uint16_t, 64 * 32> terrain{};
+    constexpr int width = 448;
+    constexpr int margin = (width - 256) / 2;
+    const uint32_t terrain_color = to_rgb32(rgb6(0x001Fu));
+    const uint32_t sprite_color = to_rgb32(rgb6(0x7C00u));
+    const uint32_t weather_color = to_rgb32(rgb6(0x03E0u));
+
+    nds_gpu2d_reset();
+    reset_obj_fixture(obj_vram);
+    g_powercontrol = 0x0002u; // Engine A feeds the bottom LCD.
+    g_3d_output_width = width;
+    g_3d_line.fill(0);
+    g_3d_line[8] = rgb6(0x03E0u) | (31u << 24);
+    g_view.bg[0] = bg_vram.data();
+    std::fill_n(bg_vram.data() + 32, 32, 0x11u); // terrain tile 1
+    write16(g_palette, 2, 0x001Fu);
+    write16(g_palette, 0x202, 0x7C00u);
+    terrain.fill(1);
+    set_4bpp_index(obj_vram, 0, 0, 1);
+    set_obj(0, 0, 422, 0); // x = -90
+    set_obj(1, 0, 320, 0); // x = 320, above the native signed X limit
+    g_unit[0].dispcnt = 0x00011908u; // composite, BG3 + BG0 weather + OBJ
+    g_unit[0].bgcnt[3] = 0x4403u;   // 512x256 text map, priority 3
+
+    nds_gpu2d_start_frame();
+    for (int y = 0; y < 192; ++y) nds_gpu2d_render_scanline(y);
+    nds_gpu2d_finish_frame();
+
+    const NdsGpu2dDungeonMap map{terrain.data(), 0, 0};
+    uint16_t actual_width = 0;
+    const uint32_t* wide = nds_gpu2d_adaptive_framebuffer(
+        1, &actual_width, NdsGpu2dScene::Dungeon, &map);
+    if (actual_width != width) { g_powercontrol = 0x8002u; return false; }
+    const uint32_t* native = nds_gpu2d_framebuffer(1);
+    bool center_matches = true;
+    for (int y = 0; y < 192; ++y) {
+        center_matches &= std::equal(native + y * 256, native + (y + 1) * 256,
+                                    wide + y * width + margin);
+    }
+    const bool routed = center_matches &&
+        wide[0] == terrain_color && wide[447] == terrain_color &&
+        wide[6] == sprite_color && wide[416] == sprite_color &&
+        wide[8] == weather_color;
+
+    wide = nds_gpu2d_adaptive_framebuffer(0, &actual_width, NdsGpu2dScene::Dungeon, &map);
+    const bool other_screen_centered = actual_width == width && wide[0] == 0xFF000000u &&
+        wide[447] == 0xFF000000u;
+    wide = nds_gpu2d_adaptive_framebuffer(1, &actual_width, NdsGpu2dScene::Dungeon);
+    const bool missing_map_centered = actual_width == width && wide[0] == 0xFF000000u &&
+        wide[447] == 0xFF000000u;
+
+    // The published weather snapshot still has the old stride immediately
+    // after an aspect change. Presentation should not read live GPU3D lines.
+    g_3d_output_width = 342;
+    const uint64_t reads = g_wide_line_reads;
+    wide = nds_gpu2d_adaptive_framebuffer(1, &actual_width, NdsGpu2dScene::Dungeon, &map);
+    const bool width_change_safe = actual_width == 342 &&
+        wide[8] == terrain_color && g_wide_line_reads == reads;
+    g_unit[0].dispcnt &= ~0x10000u; // display mode 0 with the layers still configured
+    wide = nds_gpu2d_adaptive_framebuffer(1, &actual_width, NdsGpu2dScene::Dungeon, &map);
+    const bool display_off_centered = actual_width == 342 &&
+        wide[0] == 0xFF000000u && wide[341] == 0xFF000000u;
+    g_powercontrol = 0x8002u;
+    return routed && other_screen_centered && missing_map_centered &&
+           width_change_safe && display_off_centered;
+}
