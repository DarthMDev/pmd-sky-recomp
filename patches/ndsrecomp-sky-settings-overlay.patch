+// Reads the persisted Sky aspect ratio before presentation creation. The
+// in-game menu writes this file immediately; the wider renderer width is
+// selected at launch so the GPU2D adaptive path can allocate the right
+// framebuffers and textures up front.
+uint16_t sky_saved_aspect_width(const std::string& path) {
+    int aspect = 2; // SkySettingsState defaults to 16:9.
+    if (!path.empty()) {
+        std::ifstream in(path);
+        std::string line;
+        while (std::getline(in, line)) {
+            const size_t eq = line.find('=');
+            if (eq == std::string::npos) continue;
+            std::string key = line.substr(0, eq);
+            const size_t first = key.find_first_not_of(" \t\r");
+            const size_t last = key.find_last_not_of(" \t\r");
+            if (first == std::string::npos) continue;
+            key = key.substr(first, last - first + 1);
+            if (key == "aspect_ratio") {
+                aspect = std::clamp(std::atoi(line.c_str() + eq + 1), 0, 3);
+                break;
+            }
+        }
+    }
+    static constexpr uint16_t kWidths[4] = {256, 308, 342, 448};
+    return kWidths[aspect];
+}
