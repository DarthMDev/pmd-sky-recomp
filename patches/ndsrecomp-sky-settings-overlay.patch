+void apply_single_screen_presentation(FrontendPresentation& presentation,
+                                      bool single_screen) {
+    if (presentation.separate) {
+        if (!presentation.windows[1]) return;
+        if (single_screen)
+            SDL_HideWindow(presentation.windows[1]);
+        else
+            SDL_ShowWindow(presentation.windows[1]);
+        return;
+    }
+    if (!presentation.windows[0] || !presentation.renderers[0]) return;
+    const auto window_flags = SDL_GetWindowFlags(presentation.windows[0]);
+    const bool fullscreen = (window_flags & SDL_WINDOW_FULLSCREEN) != 0;
+    int window_w = 0;
+    int window_h = 0;
+    SDL_GetWindowSize(presentation.windows[0], &window_w, &window_h);
+    const int canvas_w = presentation.canvas_width;
+    const int stacked_h = kScreenHeight * 2;
+    const int logical_h = single_screen ? kScreenHeight : stacked_h;
+    if (!fullscreen && window_w > 0 && window_h > 0) {
+        const int scale = std::max(1, window_w / std::max(1, canvas_w));
+        SDL_SetWindowSize(presentation.windows[0], canvas_w * scale,
+                          logical_h * scale);
+    }
+    set_render_logical_size(presentation.renderers[0], canvas_w, logical_h);
+}
