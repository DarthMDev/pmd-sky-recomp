+bool resize_top_screen_texture(
+    FrontendPresentation& presentation, int width,
+    skyrecomp::shaders::ShaderFilterPreset filter) {
+    if (width <= 0 || presentation.renderers[0] == nullptr) return false;
+    SDL_Texture* new_texture = SDL_CreateTexture(
+        presentation.renderers[0], SDL_PIXELFORMAT_ARGB8888,
+        SDL_TEXTUREACCESS_STREAMING, width, kScreenHeight);
+    if (new_texture == nullptr) return false;
+    SDL_Texture* new_sample = nullptr;
+    if (presentation.sample_scale > 1) {
+        new_sample = SDL_CreateTexture(
+            presentation.renderers[0], SDL_PIXELFORMAT_ARGB8888,
+            SDL_TEXTUREACCESS_TARGET, width * presentation.sample_scale,
+            kScreenHeight * presentation.sample_scale);
+        if (new_sample == nullptr) {
+            SDL_DestroyTexture(new_texture);
+            return false;
+        }
+    }
+    if (presentation.textures[0] != nullptr) {
+        SDL_DestroyTexture(presentation.textures[0]);
+    }
+    if (presentation.sample_targets[0] != nullptr) {
+        SDL_DestroyTexture(presentation.sample_targets[0]);
+    }
+    presentation.textures[0] = new_texture;
+    presentation.sample_targets[0] = new_sample;
+    presentation.screen_widths[0] = width;
+    apply_sky_shader_filter(presentation, filter);
+    return true;
+}
