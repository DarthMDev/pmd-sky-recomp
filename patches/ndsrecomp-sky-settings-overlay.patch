+void apply_sky_shader_filter(FrontendPresentation& presentation,
+                             skyrecomp::shaders::ShaderFilterPreset filter) {
+    bool linear = true;
+    presentation.post_filter = SkyPostFilter::None;
+    switch (filter) {
+        case skyrecomp::shaders::ShaderFilterPreset::Nearest:
+        case skyrecomp::shaders::ShaderFilterPreset::Pixellate:
+            linear = false;
+            break;
+        case skyrecomp::shaders::ShaderFilterPreset::NdsLcdSubpixelGrid:
+            presentation.post_filter = SkyPostFilter::LcdGrid;
+            break;
+        case skyrecomp::shaders::ShaderFilterPreset::CrtScanline:
+            presentation.post_filter = SkyPostFilter::CrtScanline;
+            break;
+        case skyrecomp::shaders::ShaderFilterPreset::SharpBilinear:
+        default:
+            break;
+    }
+    for (int screen = 0; screen < 2; ++screen) {
+        if (presentation.textures[screen]) {
+            (linear ? set_texture_scale_linear : set_texture_scale_nearest)(
+                presentation.textures[screen]);
+        }
+        if (presentation.sample_targets[screen]) {
+            (linear ? set_texture_scale_linear : set_texture_scale_nearest)(
+                presentation.sample_targets[screen]);
+        }
+    }
+}
