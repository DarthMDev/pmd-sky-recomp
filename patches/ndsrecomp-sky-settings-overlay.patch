+void draw_post_filter(SDL_Renderer* renderer, const SDL_Rect& destination,
+                      SkyPostFilter filter) {
+    if (filter == SkyPostFilter::None || destination.w <= 0 ||
+        destination.h <= 0) {
+        return;
+    }
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+    if (filter == SkyPostFilter::CrtScanline) {
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, 72);
+        for (int y = destination.y; y < destination.y + destination.h; y += 2) {
+            render_line(renderer, destination.x, y,
+                        destination.x + destination.w - 1, y);
+        }
+    } else if (filter == SkyPostFilter::LcdGrid) {
+        const int step_x = std::max(1, destination.w / kScreenWidth);
+        const int step_y = std::max(1, destination.h / kScreenHeight);
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, 28);
+        for (int x = destination.x; x < destination.x + destination.w;
+             x += step_x) {
+            render_line(renderer, x, destination.y,
+                        x, destination.y + destination.h - 1);
+        }
+        for (int y = destination.y; y < destination.y + destination.h;
+             y += step_y) {
+            render_line(renderer, destination.x, y,
+                        destination.x + destination.w - 1, y);
+        }
+    }
+}
