+const uint32_t* nds_gpu2d_dungeon_camera_frame(int screen, uint16_t width,
+    const NdsGpu2dDungeonMap& map, int16_t dx_q8, int16_t dy_q8) {
+    const int engine_a_screen = (nds_powercontrol9() & 0x8000u) ? 0 : 1;
+    if (screen != engine_a_screen || width < 256 || width > kMaxAdaptiveWidth ||
+        width != nds_gpu3d_output_width() || g_adaptive_center_native || (!dx_q8 && !dy_q8) ||
+        dx_q8 % 128 || dy_q8 % 128 || std::abs(dx_q8) > 12 * 256 || std::abs(dy_q8) > 12 * 256)
+        return nullptr;
+    drain_pool(NDS_GPU2D_FENCE_PRESENT);
+    const auto& raster = g_dungeon_raster[g_front];
+    if (raster.lines != 192 || raster.screen != static_cast<unsigned>(screen)) return nullptr;
+    const Unit& u = raster.unit;
+    const bool bg0_3d = (u.dispcnt & 0x108u) == 0x108u;
+    if (!matches_dungeon_scroll(u, map) || !wide_2d_scene_supported(u, bg0_3d))
+        return nullptr;
+    const auto* vram = nds_vram_renderer_view(0);
+    if (!vram) return nullptr;
+
+    const DungeonCameraSample camera{nds_gpu2d_framebuffer(screen),
+        dx_q8 >> 8, dy_q8 >> 8, (dx_q8 & 0x80) != 0, (dy_q8 & 0x80) != 0};
+    static AdaptiveFrame midpoint;
+    return composite_2d_wide_frame(u, raster.palette.data(), raster.oam.data(), *vram, width, (width - 256) / 2,
+                                   midpoint, map.entries, bg0_3d, &camera)
+        ? midpoint.data() : nullptr;
 }
 
