+bool test_dungeon_camera_midpoint() {
+    std::array<uint8_t, 0x4000> obj_vram{};
+    std::array<uint8_t, 0x4000> bg_vram{};
+    std::array<uint16_t, 64 * 32> terrain{};
+    const auto red = rgb6(0x001Fu);
+    const auto green = rgb6(0x03E0u);
+    const auto blue = rgb6(0x7C00u);
+
+    for (uint16_t width : {256, 448}) {
+        nds_gpu2d_reset();
+        reset_obj_fixture(obj_vram);
+        g_powercontrol = 0x0002u;
+        g_3d_output_width = static_cast<uint16_t>(width);
+        g_3d_line.fill(0u);
+        g_3d_line[20] = blue | (31u << 24);
+        g_view.bg[0] = bg_vram.data();
+        std::fill_n(bg_vram.data() + 32, 32, 0x21u); // alternating red and green terrain
+        std::fill_n(bg_vram.data() + 64, 32, 0x33u); // blue HUD/margin tile
+        for (int i = 0x2000; i < 0x3000; i += 2) bg_vram[i] = 1;
+        bg_vram[0x3000] = 2;
+        write16(g_palette, 2, 0x001Fu);
+        write16(g_palette, 4, 0x03E0u);
+        write16(g_palette, 6, 0x7C00u);
+        write16(g_palette, 0x202, 0x7C00u);
+        terrain.fill(2);
+        set_4bpp_index(obj_vram, 0, 0, 1);
+        set_obj(0, 0, 12, 0);
+        g_unit[0].dispcnt = 0x00011D08u; // BG0 weather, BG2 HUD, BG3 terrain, OBJ
+        g_unit[0].bgcnt[2] = 0x0601u;
+        g_unit[0].bgcnt[3] = 0x4403u;
+        nds_gpu2d_capture_dungeon_raster(true);
+        nds_gpu2d_start_frame();
+        for (int y = 0; y < 192; ++y) nds_gpu2d_render_scanline(y);
+        nds_gpu2d_finish_frame();
+        nds_gpu2d_capture_dungeon_raster(false);
+
+        const NdsGpu2dDungeonMap map{terrain.data(), 0, 0};
+        const uint32_t* native = nds_gpu2d_framebuffer(1);
+        const int left = (width - 256) / 2;
+        // VBlank can update live regs and palettes for the next frame.
+        g_unit[0].bgx[3] = 1;
+        write16(g_palette, 2, 0x7FFFu);
+        uint16_t x = 0, y = 0;
+        if (!nds_gpu2d_dungeon_scroll(1, x, y) || x != 0 || y != 0) return false;
+        const auto* mid = nds_gpu2d_dungeon_camera_frame(1, width, map, 128, -128);
+        if (!mid || mid[left] != to_rgb32(blue) || mid[left + 12] != to_rgb32(blue) ||
+            mid[left + 20] != to_rgb32(blue) ||
+            mid[width + left + 16] != to_rgb32(blend(red, green, 8, 8)) ||
+            mid[left + 16] != to_rgb32(blend(blue, blend(red, green, 8, 8), 8, 8)) ||
+            native[256 + 16] != to_rgb32(red)) return false;
+        if (width == 448 && mid[width + left - 1] != to_rgb32(blend(blue, red, 8, 8)))
+            return false;
+
+        // The tile pixels still come from VRAM. Reject stale or changed data.
+        bg_vram[32] = 0x22u;
+        if (nds_gpu2d_dungeon_camera_frame(1, width, map, 128, 0)) return false;
+    }
+    g_powercontrol = 0x8002u;
+    return true;
+}
