+                            second = front;
+                            front = p;
+                        } else if (ahead(p, second)) {
+                            second = p;
+                        }
+                    }
+                }
+                return finish(front, second);
+            };
+            // Live tile views or scanline effects can disagree with the
+            // captured raster. Reject the entire frame if they do.
+            if (native_column && to_rgb32(sample(terrain, hud_x, y)) != camera->native[y * 256 + hud_x])
+                return false;
+
+            const int sx = hud_x + camera->dx;
+            const int sy = y + camera->dy;
+            const auto sample_row = [&](TextLine& row, int source_y) {
+                const auto left = sample(row, sx, source_y);
+                return camera->half_x ? blend(left, sample(row, sx + 1, source_y), 8, 8) : left;
+            };
+            const auto upper = sample_row(shifted, sy);
+            dst[x] = to_rgb32(camera->half_y ? blend(upper, sample_row(next_row, sy + 1), 8, 8) : upper);
+        }
+    }
+    return true;
+}
+
+bool matches_dungeon_scroll(const Unit& u, const NdsGpu2dDungeonMap& map) {
+    return map.entries && (u.dispcnt & 0x800u) && (u.bgcnt[3] >> 14) == 1u &&
+           u.bgx[3] == (map.scroll_x & 0x1FF) &&
+           (u.bgy[3] & 0xFF) == (map.scroll_y & 0xFF);
+}
+
+void nds_gpu2d_capture_dungeon_raster(bool enabled) {
+    g_capture_dungeon_raster = enabled;
+}
+
+bool nds_gpu2d_dungeon_scroll(int screen, uint16_t& x, uint16_t& y) {
+    const auto& raster = g_dungeon_raster[g_front];
+    const auto& u = raster.unit;
+    if (raster.lines != 192 || raster.screen != static_cast<unsigned>(screen) ||
+        !(u.dispcnt & 0x800u) || (u.bgcnt[3] >> 14) != 1u) return false;
+    x = u.bgx[3];
+    y = u.bgy[3];
+    return true;
+}
