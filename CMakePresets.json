{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64-release",
      "displayName": "macOS Apple Silicon (arm64 Release)",
      "description": "Native macOS arm64 release build with SDL3 Metal presentation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/runner",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "/opt/homebrew",
        "NDS_BOOTSTRAP_FIRMWARE": "OFF",
        "NDS_ENABLE_COMPUTE_RENDERER": "OFF",
        "NDS_GENERATED_DIR": "${sourceDir}/build/generated_bios",
        "NDS_TITLE_BANK_DIR": "${sourceDir}/build/generated_sky_us",
        "NDS_TITLE_ROM_SHA1": "5fa96ca8d8dd6405d6cd2bad73ed68bc73a9d152"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Windows x64 release build with SDL3 Direct3D12/Vulkan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/runner",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NDS_BOOTSTRAP_FIRMWARE": "OFF",
        "NDS_ENABLE_COMPUTE_RENDERER": "ON",
        "NDS_GENERATED_DIR": "${sourceDir}/build/generated_bios",
        "NDS_TITLE_BANK_DIR": "${sourceDir}/build/generated_sky_us",
        "NDS_TITLE_ROM_SHA1": "5fa96ca8d8dd6405d6cd2bad73ed68bc73a9d152"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "description": "Linux x64 release build with SDL3 Vulkan/OpenGL",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/runner",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NDS_BOOTSTRAP_FIRMWARE": "OFF",
        "NDS_ENABLE_COMPUTE_RENDERER": "ON",
        "NDS_GENERATED_DIR": "${sourceDir}/build/generated_bios",
        "NDS_TITLE_BANK_DIR": "${sourceDir}/build/generated_sky_us",
        "NDS_TITLE_ROM_SHA1": "5fa96ca8d8dd6405d6cd2bad73ed68bc73a9d152"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "targets": ["nds_runner"]
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "targets": ["nds_runner"]
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release",
      "targets": ["nds_runner"]
    }
  ]
}
