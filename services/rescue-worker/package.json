{
  "name": "sky-rescue-worker",
  "version": "1.0.0",
  "description": "Zero-cost Cloudflare Worker + D1 backend for SkyRecompiled Online Friend Rescue Board",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init-local": "wrangler d1 execute DB --local --file=./schema.sql",
    "d1:init-remote": "wrangler d1 execute DB --remote --file=./schema.sql"
  },
  "keywords": [
    "pokemon-mystery-dungeon",
    "explorers-of-sky",
    "cloudflare-worker",
    "d1",
    "recompilation"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.50.0"
  }
}
