<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SkyRecompiled.Launcher.ViewModels"
        xmlns:views="using:SkyRecompiled.Launcher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        Width="1040" Height="680"
        MinWidth="900" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        x:Class="SkyRecompiled.Launcher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SkyRecompiled Launcher"
        Background="#11111B">

    <Grid ColumnDefinitions="225,*" RowDefinitions="*,Auto">

        <!-- Left Navigation Sidebar -->
        <Border Grid.Row="0" Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0" Padding="16">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,4,0,20">
                    <TextBlock Text="SkyRecompiled" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock Text="Explorers of Sky • v0.2.3" FontSize="11" Foreground="#A6ADC8"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button Classes="nav" Classes.active="{Binding IsPlayTab}"
                            Content="Play"
                            Command="{Binding SelectTabCommand}" CommandParameter="play"/>

                    <Button Classes="nav" Classes.active="{Binding IsModsTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="mods">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Mods" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#313244" CornerRadius="10" Padding="7,1"
                                    IsVisible="{Binding HasEnabledMods}">
                                <TextBlock Text="{Binding EnabledModCount}" FontSize="11" Foreground="#CBA6F7"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Classes="nav" Classes.active="{Binding IsSettingsTab}"
                            Content="Settings"
                            Command="{Binding SelectTabCommand}" CommandParameter="settings"/>

                    <Button Classes="nav" Classes.active="{Binding IsLogsSavesTab}"
                            Content="Saves &amp; Logs"
                            Command="{Binding SelectTabCommand}" CommandParameter="logssaves"/>
                </StackPanel>

                <!-- Sidebar Status Card -->
                <Border Grid.Row="2" Classes="subcard" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Environment" FontSize="11" FontWeight="SemiBold" Foreground="#89B4FA"/>
                        <TextBlock Text="{Binding RunnerStatusSummary}" FontSize="11" Foreground="#A6E3A1"
                                   TextWrapping="Wrap" IsVisible="{Binding IsRunnerFound}"/>
                        <TextBlock Text="{Binding RunnerStatusSummary}" FontSize="11" Foreground="#F38BA8"
                                   TextWrapping="Wrap" IsVisible="{Binding !IsRunnerFound}"/>
                        <Button Classes="secondary" Content="Open Data Folder" HorizontalAlignment="Stretch"
                                Padding="8,6" FontSize="11"
                                Command="{Binding OpenSaveFolderCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="18,16,18,12">
            <views:PlayView IsVisible="{Binding IsPlayTab}"/>

            <Grid IsVisible="{Binding IsModsTab}">
                <views:ModsView DataContext="{Binding Mods}"/>
            </Grid>

            <Grid IsVisible="{Binding IsSettingsTab}">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </Grid>

            <Grid IsVisible="{Binding IsLogsSavesTab}">
                <views:LogsSavesView DataContext="{Binding LogsSaves}"/>
            </Grid>
        </Grid>

        <!-- Bottom Status & Progress Bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#181825" BorderBrush="#313244" BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid ColumnDefinitions="*,220,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" FontWeight="Medium" Foreground="#CDD6F4"/>
                    <TextBlock Text="Clean-Room Notice: Zero proprietary ROMs, assets, or BIOS files are bundled."
                               FontSize="10" Foreground="#6C7086"/>
                </StackPanel>

                <ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding ProgressValue}"
                             Foreground="#89B4FA" Background="#313244" CornerRadius="3"
                             VerticalAlignment="Center" Margin="12,0"/>

                <TextBlock Grid.Column="2" Text="{Binding ProgressValue, StringFormat='{}{0:0}%'}"
                           FontSize="12" Foreground="#89B4FA" VerticalAlignment="Center"
                           IsVisible="{Binding IsProcessing}"/>
            </Grid>
        </Border>

    </Grid>
</Window>
