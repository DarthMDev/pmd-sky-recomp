<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SkyRecompiled.Launcher.ViewModels"
             xmlns:models="using:SkyRecompiled.Launcher.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SkyRecompiled.Launcher.Views.ModsView"
             x:DataType="vm:ModsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="4">

        <!-- Header & Toolbar -->
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="Layered NitroFS Mod Manager" Classes="h2"/>
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Content="Import Mod Folder..." Click="OnImportModClicked"/>
                    <Button Classes="secondary" Content="Open Mods Folder" Command="{Binding OpenModsFolderCommand}"/>
                    <Button Classes="secondary" Content="Refresh" Command="{Binding RefreshModsCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                           Text="{Binding ModsDirectoryDisplay, StringFormat='Directory: {0}'}"
                           FontSize="11" Foreground="#7F849C"/>
            </Grid>
        </Border>

        <!-- Truthful Phase-2 boundary note -->
        <Border Grid.Row="1" Background="#1E2538" BorderBrush="#3B82F6" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="Layers are validated, ordered (higher priority wins; ID breaks ties), and exported to active_mods.json. Automatic runtime NitroFS mounting into nds_runner is tracked in Milestone 4 Phase 2."
                       FontSize="12" Foreground="#BAC2DE" TextWrapping="Wrap"/>
        </Border>

        <!-- Validation Issues Banner -->
        <Border Grid.Row="2" Background="#361D28" BorderBrush="#F38BA8" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12"
                IsVisible="{Binding HasValidationIssues}">
            <StackPanel Spacing="6">
                <TextBlock Text="Skipped Invalid Mod Layers" FontSize="13" FontWeight="SemiBold" Foreground="#F38BA8"/>
                <ItemsControl ItemsSource="{Binding ValidationIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ModValidationIssue">
                            <TextBlock FontSize="12" Foreground="#F5C2E7" TextWrapping="Wrap">
                                <Run Text="{Binding FolderName}" FontWeight="SemiBold"/>
                                <Run Text=": "/>
                                <Run Text="{Binding Message}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Split View: Mod Load Order (Left) + Conflict Inspector (Right) -->
        <Grid Grid.Row="3" ColumnDefinitions="1.3*,12,*">
            <!-- Left: Mod List -->
            <Border Grid.Column="0" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="Discovered Layers (Lowest -> Highest Priority)" Classes="section"/>
                        <TextBlock Grid.Column="1" Text="{Binding EnabledCount, StringFormat='{}{0} enabled'}"
                                   FontSize="12" Foreground="#A6E3A1"/>
                    </Grid>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding HasNoMods}"
                               Text="No mods installed yet.&#x0a;Place folders containing romfs/ (and optional mod.toml) into the mods folder, or click 'Import Mod Folder...'."/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasMods}">
                        <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModItemViewModel">
                                    <Border Classes="subcard" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <CheckBox Grid.RowSpan="2" Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                                                    <Border Classes="badge" Padding="6,1">
                                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#89DCEB"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#A6ADC8"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#7F849C"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Classes="secondary" Content="-10" Padding="8,4" FontSize="11"
                                                        Command="{Binding DecreasePriorityCommand}"/>
                                                <Border Background="#252536" CornerRadius="4" Padding="8,4" MinWidth="54">
                                                    <TextBlock Text="{Binding Priority, StringFormat='P: {0}'}" FontSize="11"
                                                               Foreground="#F9E2AF" HorizontalAlignment="Center"/>
                                                </Border>
                                                <Button Classes="secondary" Content="+10" Padding="8,4" FontSize="11"
                                                        Command="{Binding IncreasePriorityCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Conflict Inspector -->
            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Overlapping File Conflicts" Classes="section" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding HasNoConflicts}"
                               Text="No overlapping NitroFS paths across currently enabled layers."/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasConflicts}">
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModConflictItem">
                                    <Border Classes="subcard" Margin="0,0,0,8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding VirtualPath}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#F9E2AF" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ChainDisplay, StringFormat='Order: {0}'}"
                                                       FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding WinnerModId, StringFormat='Winner: {0}'}"
                                                       FontSize="11" Foreground="#A6E3A1"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
